# MDA ERP — frontend (nginx static web)
# Controls the EXISTING Compose container mda_web (project "mda"); never creates a second copy.
# Source: deploy/systemd/mda-frontend.service — install with: make install-systemd
[Unit]
Description=MDA ERP frontend (nginx static web) (Compose service "web")
Documentation=file:///home/ubuntu/projects/mda/docs/deployment/SYSTEMD_OPERATIONS.md
Wants=docker.service
After=docker.service network-online.target mda-backend.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=HOME=/root
WorkingDirectory=/home/ubuntu/projects/mda
ExecStart=/home/ubuntu/projects/mda/scripts/ops/mda-service.sh start web
ExecStop=/home/ubuntu/projects/mda/scripts/ops/mda-service.sh stop web
TimeoutStartSec=120
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target

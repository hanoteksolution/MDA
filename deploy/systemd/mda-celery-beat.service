# MDA ERP — Celery beat scheduler
# Controls the EXISTING Compose container mda_celery_beat (project "mda"); never creates a second copy.
# Source: deploy/systemd/mda-celery-beat.service — install with: make install-systemd
[Unit]
Description=MDA ERP Celery beat scheduler (Compose service "celery-beat")
Documentation=file:///home/ubuntu/projects/mda/docs/deployment/SYSTEMD_OPERATIONS.md
Wants=docker.service
After=docker.service network-online.target mda-celery.service
PartOf=mda-workers.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=HOME=/root
WorkingDirectory=/home/ubuntu/projects/mda
ExecStart=/home/ubuntu/projects/mda/scripts/ops/mda-service.sh start celery-beat
ExecStop=/home/ubuntu/projects/mda/scripts/ops/mda-service.sh stop celery-beat
TimeoutStartSec=120
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target

FROM nginx:1.27-alpine

COPY infrastructure/docker/nginx.web.conf /etc/nginx/conf.d/default.conf
COPY frontend/dist /usr/share/nginx/html

# Pre-compress static assets to improve first paint latency.
RUN find /usr/share/nginx/html -type f \( -name "*.js" -o -name "*.css" -o -name "*.svg" \) -exec gzip -9 -k {} \;

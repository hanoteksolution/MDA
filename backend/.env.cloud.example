# Cloud VPS deployment — copy to backend/.env.cloud and set strong secrets
#
# Quick start:
#   cp backend/.env.cloud.example backend/.env.cloud
#   docker compose -f docker-compose.yml -f docker-compose.staging.yml up -d --build
#   docker compose exec api python manage.py migrate
#   docker compose exec api python manage.py bootstrap_system
#   ./scripts/smoke_deploy.sh http://127.0.0.1:8010

# --- Core ---
SECRET_KEY=change-this-to-a-long-random-secret
DEBUG=False

# Wildcard tenant hosts: .erp.safaritechno.com matches all shop subdomains
ALLOWED_HOSTS=.erp.safaritechno.com,erp.safaritechno.com,localhost,127.0.0.1
TENANT_BASE_DOMAIN=erp.safaritechno.com
TENANT_HOST_ENFORCEMENT=True

# --- Database (Docker service name: db) ---
DB_NAME=mda_erp
DB_USER=mda
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_HOST=db
DB_PORT=5432

# --- Redis / Celery (Docker service name: redis) ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- CORS (add your apex + tenant origins after TLS) ---
CORS_ALLOWED_ORIGINS=https://erp.safaritechno.com,https://tauri.localhost,http://localhost:5173

# --- TLS / cookies (enable when host nginx terminates HTTPS) ---
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# --- Frontend build (optional — passed to docker compose build web) ---
VITE_TENANT_BASE_DOMAIN=erp.safaritechno.com

SECRET_KEY=dev-secret-key-change-in-production
DEBUG=True
DB_NAME=mda_erp
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://tauri.localhost,http://tauri.localhost

# SaaS subdomain base: {slug}.erp.safaritechno.com
TENANT_BASE_DOMAIN=erp.safaritechno.com
# Comma-separated extra platform hosts (optional)
PLATFORM_HOSTS=
# Reject JWT users on the wrong tenant subdomain
TENANT_HOST_ENFORCEMENT=True

# Backup — Google Drive for Desktop sync folder (see infrastructure/scripts/GOOGLE_DRIVE_BACKUP.md)
# Example: GOOGLE_DRIVE_BACKUP_DIR=C:/Users/you/Google Drive/MDA-Backups
GOOGLE_DRIVE_BACKUP_DIR=
BACKUP_LOCAL_DIR=
BACKUP_RETENTION_DAYS=30
